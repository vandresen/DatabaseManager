@page  "/rules/editfunction/{Id:int}"
@inject SingletonServices singleton
@inject IRules rf
@inject NavigationManager navigationManager
@inject IDisplayMessage displayMessage

<h3>Edit Function</h3>

@if (ruleFunction != null)
{
    <FunctionForm RuleFunctions="ruleFunction"
                  OnValidSubmit="Edit"
                  OnCancel="Cancel" />
}

@code {
    [Parameter] public int Id { get; set; }
    private RuleFunctions ruleFunction;

    protected override async Task OnInitializedAsync()
    {
        ruleFunction = await rf.GetFunction(singleton.TargetConnector, Id);
        if (ruleFunction.FunctionType == null)
        {
            await displayMessage.DisplayErrorMessage("You cannot edit system functions");
            navigationManager.NavigateTo("/rules/functions");
        }
    }

    private async Task Edit()
    {
        try
        {
            await rf.UpdateFunction(ruleFunction, singleton.TargetConnector, Id);
            navigationManager.NavigateTo("/rules/functions");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private void Cancel()
    {
        navigationManager.NavigateTo("/rules/functions");
    }
}
