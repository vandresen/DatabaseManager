@using MudBlazor

<EditForm Model="RuleToEdit" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />
    <MudStack Spacing="4">

        <MudTextField @bind-Value="RuleToEdit.RuleName" For="@(() => RuleToEdit.RuleName)"
                      Label="Rule Name" Variant="Variant.Outlined" />

        <MudSelect T="string" @bind-Value="RuleToEdit.Active" For="@(() => RuleToEdit.Active)"
                   Label="Active" Variant="Variant.Outlined">
            <MudSelectItem T="string" Value="@("Y")">Y</MudSelectItem>
            <MudSelectItem T="string" Value="@("N")">N</MudSelectItem>
        </MudSelect>

        <MudSelect T="string" Value="RuleToEdit.DataType" ValueChanged="SelectedDataType"
                   Label="Data Type" Variant="Variant.Outlined">
            @foreach (var option in DataRef.DataTypeOptions)
            {
                <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
            }
        </MudSelect>

        @if (!noDataAttributes)
        {
            @if (DataAttributeOptions == null)
            {
                <MudTextField @bind-Value="RuleToEdit.DataAttribute" For="@(() => RuleToEdit.DataAttribute)"
                              Label="Data Attribute" Variant="Variant.Outlined" />
            }
            else
            {
                <MudSelect T="string" @bind-Value="RuleToEdit.DataAttribute" For="@(() => RuleToEdit.DataAttribute)"
                           Label="Data Attribute" Variant="Variant.Outlined">
                    @foreach (var att in DataAttributeOptions)
                    {
                        <MudSelectItem T="string" Value="@att">@att</MudSelectItem>
                    }
                </MudSelect>
            }
        }

        @if (Type == "Validity" || Type == "Predictions")
        {
            <MudSelect T="string" @bind-Value="RuleToEdit.RuleFunction" For="@(() => RuleToEdit.RuleFunction)"
                       Label="Rule Function" Variant="Variant.Outlined">
                @foreach (var func in FunctionMethods)
                {
                    <MudSelectItem T="string" Value="@func">@func</MudSelectItem>
                }
            </MudSelect>
        }

        <div>
            <MudText Typo="Typo.body2" Class="mb-1">Rule Parameters</MudText>
            <RuleParametersEditor RuleFunction="@RuleToEdit.RuleFunction"
                                  DataAttributeOptions="DataAttributeOptions"
                                  DataTypeOptions="DataRef.DataTypeOptions"
                                  RuleParameters="@RuleToEdit.RuleParameters"
                                  RuleParametersChanged="@((string v) => RuleToEdit.RuleParameters = v)" />
            <ValidationMessage For="@(() => RuleToEdit.RuleParameters)" />
        </div>

        <MudTextField @bind-Value="RuleToEdit.RuleFilter" For="@(() => RuleToEdit.RuleFilter)"
                      Label="Rule Filter" Variant="Variant.Outlined" />

        @if (Type == "Predictions")
        {
            <MudTextField @bind-Value="RuleToEdit.FailRule" For="@(() => RuleToEdit.FailRule)"
                          Label="Fail Rule" Variant="Variant.Outlined" />

            <MudNumericField T="int" @bind-Value="RuleToEdit.PredictionOrder" For="@(() => RuleToEdit.PredictionOrder)"
                             Label="Prediction Order" Variant="Variant.Outlined" />
        }

        <MudTextField @bind-Value="RuleToEdit.RuleDescription" For="@(() => RuleToEdit.RuleDescription)"
                      Label="Description" Variant="Variant.Outlined" Lines="3" />

        <MudStack Row="true" Spacing="2">
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Success">
                Save Changes
            </MudButton>
            <MudButton ButtonType="ButtonType.Button" Variant="Variant.Outlined" Color="Color.Default"
                       OnClick="OnCancel">
                Cancel
            </MudButton>
        </MudStack>

    </MudStack>
</EditForm>

@code {
    [Parameter] public RuleModel RuleToEdit { get; set; }
    [Parameter] public RuleInfo DataRef { get; set; }
    [Parameter] public string Type { get; set; }
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public List<string> FunctionMethods { get; set; }
    private List<string> DataAttributeOptions;
    private bool noDataAttributes = false;

    protected override void OnInitialized()
    {
        string dataType = DataRef.DataTypeOptions[0];
        DataAttributeOptions = GetAttributes(DataRef.DataAttributes[dataType]);
        RuleToEdit.DataType = dataType;
        RuleToEdit.RuleType = Type;
        RuleToEdit.Active = "Y";
        RuleToEdit.DataAttribute = DataAttributeOptions[0];
        RuleToEdit.RuleFunction = (Type == "Validity" || Type == "Predictions")
            ? FunctionMethods.FirstOrDefault()
            : Type;
        if (Type == "Entirety" || Type == "Uniqueness") noDataAttributes = true;
    }

    private void SelectedDataType(string dataType)
    {
        RuleToEdit.DataType = dataType;
        DataAttributeOptions = GetAttributes(DataRef.DataAttributes[dataType]);
        RuleToEdit.DataAttribute = DataAttributeOptions.Count > 0 ? DataAttributeOptions[0] : null;
    }

    private List<string> GetAttributes(string attributeList)
    {
        List<string> attributes = attributeList.Split(',').ToList();
        return attributes;
    }
}