@using MudBlazor

<MudCard Class="mx-auto my-4" Style="max-width: 700px;">
    <MudCardContent>
        <MudText Typo="Typo.h5" Class="mb-4">Edit @type Rule</MudText>

        @if (staleDataType)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                This rule's data type ("@RuleToEdit.DataType") is no longer available in the current configuration.
                Please select a valid data type below before saving.
            </MudAlert>
        }

        <MudForm @ref="form" Model="@RuleToEdit" OnValidSubmit="HandleValidSubmit">
            <MudGrid Spacing="2">

                <MudItem xs="12">
                    <MudTextField @bind-Value="RuleToEdit.RuleName"
                                  Label="Rule Name"
                                  For="@(() => RuleToEdit.RuleName)"
                                  Required="true"
                                  MaxLength="40"
                                  Variant="Variant.Filled"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="RuleToEdit.Active"
                               Label="Active" Variant="Variant.Filled" Margin="Margin.Dense">
                        <MudSelectItem T="string" Value="@("Y")">Y</MudSelectItem>
                        <MudSelectItem T="string" Value="@("N")">N</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField Value="@RuleToEdit.RuleFunction"
                                  Label="Rule Function"
                                  Variant="Variant.Filled" Margin="Margin.Dense"
                                  ReadOnly="true" Disabled="true" />
                </MudItem>

                @if (dataAttributeMenu)
                {
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" Value="RuleToEdit.DataType" ValueChanged="OnDataTypeChanged"
                                   Label="Data Type" Variant="Variant.Filled" Margin="Margin.Dense"
                                   Error="@staleDataType" ErrorText="Invalid data type">
                            @if (staleDataType)
                            {
                                <MudSelectItem T="string" Value="@RuleToEdit.DataType" Disabled="true">
                                    @RuleToEdit.DataType (invalid)
                                </MudSelectItem>
                            }
                            @foreach (var option in DataRef.DataTypeOptions)
                            {
                                <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" @bind-Value="RuleToEdit.DataAttribute"
                                   Label="Data Attribute" Variant="Variant.Filled" Margin="Margin.Dense"
                                   Disabled="@staleDataType">
                            @foreach (var att in DataAttributeOptions)
                            {
                                <MudSelectItem T="string" Value="@att">@att</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Rule Parameters</MudText>
                    <RuleParametersEditor RuleFunction="@RuleToEdit.RuleFunction"
                                          DataAttributeOptions="@DataAttributeOptions"
                                          DataTypeOptions="@DataRef.DataTypeOptions"
                                          @bind-RuleParameters="@RuleToEdit.RuleParameters" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="RuleToEdit.RuleFilter"
                                  Label="Rule Filter"
                                  For="@(() => RuleToEdit.RuleFilter)"
                                  Variant="Variant.Filled" Margin="Margin.Dense" />
                </MudItem>

                @if (type == "Predictions")
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="RuleToEdit.FailRule"
                                      Label="Fail Rule"
                                      For="@(() => RuleToEdit.FailRule)"
                                      Variant="Variant.Filled" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField @bind-Value="RuleToEdit.PredictionOrder"
                                         Label="Prediction Order"
                                         For="@(() => RuleToEdit.PredictionOrder)"
                                         Variant="Variant.Filled" Margin="Margin.Dense" />
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudTextField @bind-Value="RuleToEdit.RuleDescription"
                                  Label="Description"
                                  For="@(() => RuleToEdit.RuleDescription)"
                                  Variant="Variant.Filled" Margin="Margin.Dense"
                                  Lines="2" MaxLength="255" />
                </MudItem>

                <MudItem xs="12" class="d-flex justify-end">
                    <MudButton Color="Color.Success" Variant="Variant.Filled"
                               OnClick="HandleValidSubmit" Disabled="@staleDataType">
                        Save Changes
                    </MudButton>
                </MudItem>

            </MudGrid>
        </MudForm>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public RuleModel RuleToEdit { get; set; }
    [Parameter] public RuleInfo DataRef { get; set; }
    [Parameter] public EventCallback OnValidSubmit { get; set; }

    private MudForm form;
    private List<string> DataAttributeOptions;
    private bool dataAttributeMenu = true;
    private string type;
    private bool staleDataType = false;

    protected override void OnInitialized()
    {
        type = RuleToEdit.RuleType;
        if (type == "Predictions" || type == "Entirety" || type == "Uniqueness") dataAttributeMenu = false;

        RefreshDataAttributeOptions();
    }

    private void RefreshDataAttributeOptions()
    {
        if (RuleToEdit.DataType != null && DataRef.DataAttributes.TryGetValue(RuleToEdit.DataType, out var attributeList))
        {
            DataAttributeOptions = GetAttributes(attributeList);
            staleDataType = false;
        }
        else
        {
            DataAttributeOptions = new List<string>();
            staleDataType = true;
        }
    }

    private void OnDataTypeChanged(string newDataType)
    {
        RuleToEdit.DataType = newDataType;
        RefreshDataAttributeOptions();
        // Old DataAttribute almost certainly doesn't belong to the newly selected
        // data type - reset it, same as the create form does.
        RuleToEdit.DataAttribute = DataAttributeOptions.FirstOrDefault();
    }

    private List<string> GetAttributes(string attributeList)
    {
        List<string> attributes = attributeList.Split(',').ToList();
        return attributes;
    }

    private async Task HandleValidSubmit()
    {
        await form.Validate();
        if (form.IsValid && !staleDataType && OnValidSubmit.HasDelegate)
        {
            await OnValidSubmit.InvokeAsync();
        }
    }
}