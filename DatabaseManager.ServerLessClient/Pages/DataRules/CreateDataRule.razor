@page "/createdatarule/{RuleType}"

@inject IDataConfigurationService dcs
@inject IPopupMessage dm
@inject IRuleService rules
@inject NavigationManager navigationManager
@using DatabaseManager.ServerLessClient.Helpers;
@using MudBlazor

<h3>New @RuleType Rule</h3>

<MudOverlay @bind-Visible="_isBusy" DarkBackground="true" Absolute="false">
    <div class="d-flex flex-column align-items-center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Class="mt-2">@_busyMessage</MudText>
    </div>
</MudOverlay>

@if (_loadFailed)
{
    <MudAlert Severity="Severity.Error">
        Could not load the data needed to create a rule.
        <MudButton Variant="Variant.Text" OnClick="LoadAsync">Retry</MudButton>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Back</MudButton>
    </MudAlert>
}
else if (ruleInfo != null && functionMethods != null)
{
    <NewDataRuleForm RuleToEdit="ruleModel" DataRef="ruleInfo" Type="@type"
                     FunctionMethods="functionMethods"
                     OnValidSubmit="Create" OnCancel="Cancel" IsBusy="@_isBusy" />
}

@code {
    [Parameter] public string RuleType { get; set; }
    public RuleModel ruleModel = new RuleModel();
    public RuleInfo ruleInfo;
    private List<RuleFunctionDto> FunctionList;
    public string type;
    public List<string> functionMethods;
    private bool _isBusy = true;
    private string _busyMessage = "Loading...";
    private bool _loadFailed;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loadFailed = false;
        _isBusy = true;
        _busyMessage = "Loading...";
        StateHasChanged();

        try
        {
            var infoTask = GetRuleInfo();
            var functionsTask = rules.GetFunctionsAsync();
            await Task.WhenAll(infoTask, functionsTask);

            type = RuleType;
            string shortType = type switch
            {
                "Validity" => "V",
                "Predictions" => "P",
                _ => ""
            };

            // assign only after both calls succeeded
            FunctionList = functionsTask.Result;
            functionMethods = FunctionList
                .Where(s => s.FunctionType == shortType)
                .Select(s => s.FunctionName)
                .ToList();
            ruleInfo = infoTask.Result;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading create page: {ex}");
            _loadFailed = true;
            await dm.DisplayErrorMessage("Problems loading the page");
        }
        finally
        {
            _isBusy = false;
            StateHasChanged();
        }
    }

    private async Task<RuleInfo> GetRuleInfo()
    {
        ResponseDto response = await dcs.GetRecord<ResponseDto>("PPDMDataAccess.json");
        if (response == null || !response.IsSuccess)
        {
            Console.WriteLine(response?.ErrorMessages);
            throw new InvalidOperationException("Error getting rule info");
        }
        string content = Convert.ToString(response.Result);
        List<DataAccessDef> accessDefs = JsonConvert.DeserializeObject<List<DataAccessDef>>(content);
        RuleInfo ruleInfo = new RuleInfo();
        ruleInfo.DataTypeOptions = new List<string>();
        ruleInfo.DataAttributes = new Dictionary<string, string>();
        foreach (DataAccessDef accessDef in accessDefs)
        {
            ruleInfo.DataTypeOptions.Add(accessDef.DataType);
            string select = accessDef.Select;
            string[] attributeArray = select.GetAttributes().Select(x => x.Trim()).ToArray();
            string attributes = string.Join(",", attributeArray);
            ruleInfo.DataAttributes.Add(accessDef.DataType, attributes);
        }
        return ruleInfo;
    }

    private async Task Create()
    {
        if (_isBusy) return;

        _isBusy = true;
        _busyMessage = "Saving rule...";
        StateHasChanged();

        try
        {
            await rules.InsertRuleAsync(ruleModel);
            navigationManager.NavigateTo("datarules");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            await dm.DisplayErrorMessage("Failed to save rule");
            _isBusy = false;
            StateHasChanged();
        }
    }

    private void Cancel() => navigationManager.NavigateTo("datarules");
}
