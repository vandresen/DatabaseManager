@page "/editdatarules/{Id:int}"
@inject NavigationManager navigationManager
@inject IDataConfigurationService dcs
@inject IPopupMessage dm
@inject IRuleService rules
@using MudBlazor
@* @using DatabaseManager.ServerLessClient.Helpers; *@

<h3>Edit Rule</h3>

<MudOverlay @bind-Visible="_isBusy" DarkBackground="true" Absolute="false">
    <div class="d-flex flex-column align-items-center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Class="mt-2">@_busyMessage</MudText>
    </div>
</MudOverlay>

@if (_loadFailed)
{
    <MudAlert Severity="Severity.Error">
        Could not load this rule.
        <MudButton Variant="Variant.Text" OnClick="LoadAsync">Retry</MudButton>
    </MudAlert>
}
else if (ruleModel != null)
{
    <EditDataRuleForm RuleToEdit="ruleModel" DataRef="ruleInfo" OnValidSubmit="Edit" OnCancel="Cancel" />
}

@code {
    [Parameter] public int Id { get; set; }
    public RuleModelDto ruleModelDto;
    public RuleModel ruleModel;
    public RuleInfo ruleInfo;
    private bool _isBusy = true;          // true from the start so there's no blank flash
    private string _busyMessage = "Loading rule...";
    private bool _loadFailed;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loadFailed = false;
        _isBusy = true;
        _busyMessage = "Loading rule...";
        StateHasChanged();

        try
        {
            // run both calls at the same time instead of one after the other
            var infoTask = GetRuleInfo();
            var ruleTask = rules.GetRuleAsync("", Id);
            await Task.WhenAll(infoTask, ruleTask);

            ruleInfo = infoTask.Result;
            ruleModelDto = ruleTask.Result;
            ruleModel = ruleModelDto.FromRuleModelDto();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading rule {Id}: {ex}");
            _loadFailed = true;
            await dm.DisplayErrorMessage("Problems loading the rule");
        }
        finally
        {
            _isBusy = false;
            StateHasChanged();
        }
    }

    private async Task Edit()
    {
        if (_isBusy) return;              // blocks double submit

        _isBusy = true;
        _busyMessage = "Saving rule...";
        StateHasChanged();

        try
        {
            await rules.UpdateRuleAsync(ruleModel);
            navigationManager.NavigateTo("datarules");   // leave the overlay up until the page changes
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            await dm.DisplayErrorMessage("Failed to save rule");
            _isBusy = false;              // only reset on failure
            StateHasChanged();
        }
    }

    private async Task<RuleInfo> GetRuleInfo()
    {
        string content = "";
        DatabaseManager.ServerLessClient.Models.ResponseDto response = await dcs.GetRecord<DatabaseManager.ServerLessClient.Models.ResponseDto>("PPDMDataAccess.json");
        if (response != null && response.IsSuccess)
        {
            content = Convert.ToString(response.Result);
            Console.WriteLine(content);
        }
        else
        {
            Console.WriteLine(response.ErrorMessages);
            await dm.DisplayErrorMessage("Error getting rule info");
        }
        List<DataAccessDef> accessDefs = JsonConvert.DeserializeObject<List<DataAccessDef>>(content);
        RuleInfo ruleInfo = new RuleInfo();
        ruleInfo.DataTypeOptions = new List<string>();
        ruleInfo.DataAttributes = new Dictionary<string, string>();
        foreach (DataAccessDef accessDef in accessDefs)
        {
            ruleInfo.DataTypeOptions.Add(accessDef.DataType);
            string select = accessDef.Select;
            string[] attributeArray = select.GetAttributes().Select(x => x.Trim()).ToArray();
            string attributes = string.Join(",", attributeArray);
            ruleInfo.DataAttributes.Add(accessDef.DataType, attributes);
        }
        return ruleInfo;
    }

    private void Cancel() => navigationManager.NavigateTo("datarules");
}
