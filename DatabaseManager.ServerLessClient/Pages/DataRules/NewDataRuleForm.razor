@using MudBlazor

<MudCard Class="mx-auto my-4" Style="max-width: 700px;">
    <MudCardContent>
        <MudText Typo="Typo.h5" Class="mb-4">New @Type Rule</MudText>

        <MudForm @ref="form" Model="@RuleToEdit" OnValidSubmit="HandleValidSubmit">
            <MudGrid Spacing="2">

                <MudItem xs="12">
                    <MudTextField @bind-Value="RuleToEdit.RuleName"
                                  Label="Rule Name"
                                  For="@(() => RuleToEdit.RuleName)"
                                  Required="true"
                                  MaxLength="40"
                                  Variant="Variant.Filled"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="RuleToEdit.Active"
                               Label="Active" Variant="Variant.Filled" Margin="Margin.Dense">
                        <MudSelectItem T="string" Value="@("Y")">Y</MudSelectItem>
                        <MudSelectItem T="string" Value="@("N")">N</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Value="RuleToEdit.DataType" ValueChanged="SelectedDataType"
                               Label="Data Type" Variant="Variant.Filled" Margin="Margin.Dense">
                        @foreach (var option in DataRef.DataTypeOptions)
                        {
                            <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @if (!noDataAttributes)
                {
                    <MudItem xs="12">
                        @if (DataAttributeOptions == null)
                        {
                            <MudTextField @bind-Value="RuleToEdit.DataAttribute"
                                          Label="Data Attribute"
                                          For="@(() => RuleToEdit.DataAttribute)"
                                          Variant="Variant.Filled" Margin="Margin.Dense" />
                        }
                        else
                        {
                            <MudSelect T="string" @bind-Value="RuleToEdit.DataAttribute"
                                       Label="Data Attribute" Variant="Variant.Filled" Margin="Margin.Dense">
                                @foreach (var att in DataAttributeOptions)
                                {
                                    <MudSelectItem T="string" Value="@att">@att</MudSelectItem>
                                }
                            </MudSelect>
                        }
                    </MudItem>
                }

                @if (Type == "Validity" || Type == "Predictions")
                {
                    <MudItem xs="12">
                        <MudSelect T="string" @bind-Value="RuleToEdit.RuleFunction" @bind-Value:after="OnRuleFunctionChanged"
                                   Label="Rule Function" Variant="Variant.Filled" Margin="Margin.Dense">
                            @foreach (var func in FunctionMethods)
                            {
                                <MudSelectItem T="string" Value="@func">@func</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Rule Parameters</MudText>
                    <RuleParametersEditor RuleFunction="@RuleToEdit.RuleFunction"
                                          DataAttributeOptions="@DataAttributeOptions"
                                          DataTypeOptions="@DataRef.DataTypeOptions"
                                          @bind-RuleParameters="@RuleToEdit.RuleParameters" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="RuleToEdit.RuleFilter"
                                  Label="Rule Filter"
                                  For="@(() => RuleToEdit.RuleFilter)"
                                  Variant="Variant.Filled" Margin="Margin.Dense" />
                </MudItem>

                @if (Type == "Predictions")
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="RuleToEdit.FailRule"
                                      Label="Fail Rule"
                                      For="@(() => RuleToEdit.FailRule)"
                                      Variant="Variant.Filled" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField @bind-Value="RuleToEdit.PredictionOrder"
                                         Label="Prediction Order"
                                         For="@(() => RuleToEdit.PredictionOrder)"
                                         Variant="Variant.Filled" Margin="Margin.Dense" />
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudTextField @bind-Value="RuleToEdit.RuleDescription"
                                  Label="Description"
                                  For="@(() => RuleToEdit.RuleDescription)"
                                  Variant="Variant.Filled" Margin="Margin.Dense"
                                  Lines="2" MaxLength="255" />
                </MudItem>

                <MudItem xs="12" class="d-flex justify-end">
                    <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="HandleValidSubmit">
                        Save Changes
                    </MudButton>
                </MudItem>

            </MudGrid>
        </MudForm>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public DatabaseManager.ServerLessClient.Models.RuleModel RuleToEdit { get; set; }
    [Parameter] public RuleInfo DataRef { get; set; }
    [Parameter] public string Type { get; set; }
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public List<string> FunctionMethods { get; set; }

    private MudForm form;
    private List<string> DataAttributeOptions;
    private bool noDataAttributes = false;

    protected override void OnInitialized()
    {
        string dataType = DataRef.DataTypeOptions[0];
        DataAttributeOptions = GetAttributes(DataRef.DataAttributes[dataType]);
        RuleToEdit.DataType = dataType;
        RuleToEdit.RuleType = Type;
        RuleToEdit.Active = "Y";
        RuleToEdit.DataAttribute = DataAttributeOptions[0];
        RuleToEdit.RuleFunction = Type;
        if (Type == "Entirety" || Type == "Uniqueness") noDataAttributes = true;
    }

    private void SelectedDataType(string dataType)
    {
        RuleToEdit.DataType = dataType;
        DataAttributeOptions = GetAttributes(DataRef.DataAttributes[dataType]);
        // The old DataAttribute almost certainly doesn't belong to the newly selected
        // data type - reset it, same as OnInitialized does for the default type,
        // instead of silently saving a value from the previous data type.
        RuleToEdit.DataAttribute = DataAttributeOptions.FirstOrDefault();
    }

    private List<string> GetAttributes(string attributeList)
    {
        List<string> attributes = attributeList.Split(',').ToList();
        return attributes;
    }

    private void OnRuleFunctionChanged()
    {
        // Switching rule functions means any previously entered parameters no longer
        // apply - let RuleParametersEditor populate fresh defaults for the new function.
        RuleToEdit.RuleParameters = null;
    }

    private async Task HandleValidSubmit()
    {
        await form.Validate();
        if (form.IsValid && OnValidSubmit.HasDelegate)
        {
            await OnValidSubmit.InvokeAsync();
        }
    }
}
