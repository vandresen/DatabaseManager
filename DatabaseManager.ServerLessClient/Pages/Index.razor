@page "/"
@inject ILocalStorageService localStorage
@inject BlazorSingletonService settings
@inject HttpClient client
@inject IPopupMessage displayMessage
@inject NavigationManager navigationManager
@inject IIndexView idxView
@inject IDatabaseManagementService dmService
@inject IDataSources dataSourceService
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@using MudBlazor

<div class="jumbotron">
    <h1>Welcome to Database Manager</h1>
    <p class="lead">The tool to manage your PPDM databases</p>
</div>

@if (sqlite)
{
    <p>Project: @settings.Project</p>
    @if (projects == null)
    {
        <br />
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <br />
        <text>Loading...</text>
        <br />
    }
    else
    {
        <GenericSelector Options="projects" Selection="SelectedProject" Label="Choose Project" />
    }
}
else
{
    <p>Target Database: @settings.TargetConnector</p>

    @if (options == null)
    {
        <br />
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <br />
        <text>Loading...</text>
        <br />
    }
    else
    {
        <GenericSelector Options="options" Selection="Selected" Label="Choose Connector" />
    }
}

@if (index == null)
{
    @if (spinner)
    {
        <br/>
        <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
        <br/>
    }
    <text>@indexStatus</text>
}
else
{
    <MudTable Items="@index" Hover="true" Bordered="true" Striped="true" Outlined="true" Dense="true">
        <ColGroup>
            <col style="width:10px;" />
            <col />
            <col />
        </ColGroup>
        <HeaderContent>
            <MudTh style="background-color:lightgray"></MudTh>
            <MudTh style="background-color:lightgray">Data Type</MudTh>
            <MudTh style="background-color:lightgray">Number Of Data Objects</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="">
                <MudFab @onclick="@(() => DataTypes(context))" Color="Color.Info" StartIcon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" IconSize="Size.Small" />
            </MudTd>
            <MudTd DataLabel="Sign">@context.DataType</MudTd>
            <MudTd DataLabel="Name">@context.NumberOfDataObjects</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    public List<ConnectParameters> ConnectParameters;
    private List<string> projects;
    private List<string> options;
    public List<DmsIndex> index;
    private string indexStatus = "No index available";
    bool spinner = false;
    bool sqlite = false;
    private int indexRequestId = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await settings.LoadFromLocalStorageAsync(localStorage);
            sqlite = SD.Sqlite;

            var missingSettings = settings.GetMissingRequiredSettings();
            if (missingSettings.Any())
            {
                await displayMessage.DisplayErrorMessage(
                    $"Required settings are missing: {string.Join(", ", missingSettings)}. " +
                    "Go to Settings to fix this before continuing.");
                return; // stop here - don't attempt calls that will just fail
            }

            if (!string.IsNullOrEmpty(settings.AzureStorage))
            {
                client.DefaultRequestHeaders.Remove("AzureStorageConnection");
                client.DefaultRequestHeaders.Add("AzureStorageConnection", settings.AzureStorage);
            }

            settings.DataAccessDefinition = await GetDataAccessDef();

            if (sqlite)
            {
                projects = await idxView.GetIndexProjects();
                if (string.IsNullOrEmpty(settings.Project) == true) settings.Project = "Default";
                await GetIndexData();
            }
            else
            {
                ResponseDto response = await dataSourceService.GetSources<ResponseDto>();
                if (response != null && response.IsSuccess)
                {
                    ConnectParameters = JsonConvert.DeserializeObject<List<ConnectParameters>>(Convert.ToString(response.Result));
                }
                else
                {
                    Console.WriteLine(response.ErrorMessages);
                    await displayMessage.DisplayErrorMessage(" There is a problem accessing data source server");
                }
                options = new List<string>();
                foreach (ConnectParameters conn in ConnectParameters)
                {
                    if (conn.SourceType != "File") options.Add(conn.SourceName);
                }
                if (!string.IsNullOrEmpty(settings.TargetConnector))
                {
                    await GetIndexData();
                }
            }
            if (string.IsNullOrEmpty(settings.AzureStorage))
            {
                await displayMessage.DisplayErrorMessage("Azure Storage connection string is required. Go to Settings dialog to set it.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            if (ex.ToString().Contains("Connection string is not set"))
            {
                await displayMessage.DisplayErrorMessage("Azure storage connection string is missing. Use Settings to set it temporary for the session");
            }
            else if (ex.ToString().Contains("Unauthorized"))
            {
                await displayMessage.DisplayErrorMessage("API key may be missing or invalid. Use Settings to set it");
            }
            else
            {
                await displayMessage.DisplayErrorMessage(" There is a problem accessing server");
            }
        }
    }

    private async Task Selected(string selectedString)
    {
        settings.TargetConnector = selectedString;

        // Wipe the old table immediately and show the wait indicator
        index = null;
        spinner = true;
        indexStatus = "Fetching index";
        StateHasChanged();

        // Persist the new selection
        await settings.SaveToLocalStorageAsync(localStorage);   // <-- use your actual save method

        await GetIndexData();
    }

    private async Task SelectedProject(string selectedString)
    {
        Console.WriteLine($"Selected project is {selectedString}");
        settings.Project = selectedString;
        spinner = true;
        indexStatus = "Fetching index";
        StateHasChanged();
        await GetIndexData();
    }

    private async Task GetIndexData()
    {
        int requestId = ++indexRequestId;
        try
        {
            var result = sqlite
                ? await idxView.GetIndex(settings.Project)
                : await idxView.GetIndex(settings.TargetConnector);

            // A newer selection was made while we were waiting - discard this result
            if (requestId != indexRequestId) return;

            index = result;
        }
        catch (Exception ex)
        {
            if (requestId != indexRequestId) return;

            index = null;
            Console.WriteLine(ex);
            indexStatus = "No index found";
        }
        finally
        {
            if (requestId == indexRequestId)
            {
                spinner = false;
                StateHasChanged();
            }
        }
    }

    private async Task<string> GetDataAccessDef()
    {
        ResponseDto response = await dmService.GetDataAccessDef<ResponseDto>();
        if (!response.IsSuccess)
        {
            await displayMessage.DisplayErrorMessage("Cannot get data access definition");
            throw new InvalidOperationException($"Cannot get data access definition");
        }
        return response.Result.ToString()!;
    }

    private void DataTypes(DmsIndex item)
    {
        string url = @"/ChildData/" + $"{item.Id}";
        navigationManager.NavigateTo(url);
    }
}
