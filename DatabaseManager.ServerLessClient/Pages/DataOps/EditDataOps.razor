@page "/dataops/edit/{Name}"
@using MudBlazor
@using Newtonsoft.Json
@inject DatabaseManager.ServerLessClient.Services.IDataOps dataOps
@inject IPopupMessage displayMessage

<h3>Edit DataOps Pipeline</h3>

<div class="mb-4">
    <MudMenu Label="New Tube" Variant="Variant.Filled" Color="Color.Secondary"
             EndIcon="@Icons.Material.Filled.ArrowDropDown">
        @foreach (var tube in TubeTypes)
        {
            <MudMenuItem Href="@($"createtube/{Name}/{tube}")">@tube</MudMenuItem>
        }
    </MudMenu>
</div>

@if (tubes == null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudTable Items="@tubes" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Filter="FilterTubes">
        <HeaderContent>
            <MudTh style="background-color:lightgray">
                Action
                <MudTooltip Text="Clear all filters">
                    <MudIconButton Icon="@Icons.Material.Filled.FilterAltOff"
                                   Color="Color.Secondary"
                                   OnClick="@ClearFilters"
                                   Size="Size.Small" />
                </MudTooltip>
            </MudTh>

            <MudTh style="background-color:lightgray">
                <MudTableSortLabel SortBy="@((PipeLine x) => x.Priority)"
                                   InitialDirection="SortDirection.Ascending">Priority</MudTableSortLabel>
                <MudTextField @bind-Value="filterPriority" Margin="Margin.Dense" Variant="Variant.Outlined" />
            </MudTh>

            <MudTh style="background-color:lightgray">
                <MudTableSortLabel SortBy="@((PipeLine x) => x.ArtifactType)">Tube Type</MudTableSortLabel>
                <MudTextField @bind-Value="filterTubeType" Margin="Margin.Dense" Variant="Variant.Outlined" />
            </MudTh>

            <MudTh style="background-color:lightgray">
                <MudTableSortLabel SortBy="@((PipeLine x) => x.Parameters)">Parameters</MudTableSortLabel>
                <MudTextField @bind-Value="filterParameters" Margin="Margin.Dense" Variant="Variant.Outlined" />
            </MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd Style="white-space:nowrap">
                <MudFab StartIcon="@Icons.Material.Filled.Edit"
                        Color="Color.Secondary"
                        Size="Size.Small"
                        IconSize="Size.Small"
                        Class="me-1"
                        Href="@($"/edittube/{Name}/{context.Id}")" />
                <MudFab StartIcon="@Icons.Material.Filled.Delete"
                        Color="Color.Primary"
                        Size="Size.Small"
                        IconSize="Size.Small"
                        @onclick="@(() => DeleteTube(context.Id))" />
            </MudTd>
            <MudTd DataLabel="Priority">@context.Priority</MudTd>
            <MudTd DataLabel="Tube Type">@context.ArtifactType</MudTd>
            <MudTd DataLabel="Parameters">@context.Parameters</MudTd>
        </RowTemplate>

        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
}

@code {
    [Parameter] public string Name { get; set; }

    private List<string> TubeTypes = new() { "DataTransfer", "CreateIndex", "DataQC", "Predictions" };
    private List<PipeLine>? tubes;
    private string filterPriority = string.Empty;
    private string filterTubeType = string.Empty;
    private string filterParameters = string.Empty;
    private DatabaseManager.ServerLessClient.Models.ResponseDto response;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await RefreshTubes();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errors in edit data ops: {ex}");
            await displayMessage.DisplayErrorMessage("Problems getting pipeline");
        }
    }

    private async Task RefreshTubes()
    {
        response = await dataOps.GetPipeline<DatabaseManager.ServerLessClient.Models.ResponseDto>(Name);
        tubes = JsonConvert.DeserializeObject<List<PipeLine>>(Convert.ToString(response.Result))
                ?? new List<PipeLine>();
    }

    private bool FilterTubes(PipeLine tube)
    {
        return (string.IsNullOrWhiteSpace(filterPriority) || tube.Priority.ToString().Contains(filterPriority, StringComparison.OrdinalIgnoreCase))
            && (string.IsNullOrWhiteSpace(filterTubeType) || tube.ArtifactType?.ToString().Contains(filterTubeType, StringComparison.OrdinalIgnoreCase) == true)
            && (string.IsNullOrWhiteSpace(filterParameters) || tube.Parameters?.ToString().Contains(filterParameters, StringComparison.OrdinalIgnoreCase) == true);
    }

    private void ClearFilters()
    {
        filterPriority = string.Empty;
        filterTubeType = string.Empty;
        filterParameters = string.Empty;
    }

    private async Task DeleteTube(int id)
    {
        try
        {
            await RefreshTubes();
            tubes!.RemoveAll(x => x.Id == id);
            DataOpsPipes pipe = new DataOpsPipes { Name = Name };
            response = await dataOps.SavePipeline<DatabaseManager.ServerLessClient.Models.ResponseDto>(pipe, tubes);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errors: {ex}");
            await displayMessage.DisplayErrorMessage("Failed to delete tube");
        }
    }
}