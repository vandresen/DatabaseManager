@page "/dataops"
@using MudBlazor
@inject IPopupMessage displayMessage
@inject DatabaseManager.ServerLessClient.Services.IDataOps dataOps
@inject BlazorSingletonService settings
@implements IDisposable

<h3>Data Ops</h3>

<div style="display:inline-flex; flex-direction:row; justify-content:flex-start; align-items:center; gap:12px; width:max-content; margin-bottom:16px;">
    <MudTextField @bind-Value="pipelineName"
                  Label="New Pipeline"
                  Margin="Margin.Dense"
                  Variant="Variant.Outlined"
                  Style="width:260px;" />

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="AddPipeline">
        Add New Pipeline
    </MudButton>
</div>

<MudDivider Class="mb-4" />

@if (pipeList == null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudTable Items="@pipeList"
              Dense="true"
              Hover="true"
              Breakpoint="Breakpoint.Sm"
              Filter="FilterPipes">
        <HeaderContent>
            <MudTh Style="background-color:lightgray; width:50px;">
                Action
                <MudTooltip Text="Clear all filters">
                    <MudIconButton Icon="@Icons.Material.Filled.FilterAltOff"
                                   Color="Color.Secondary"
                                   OnClick="@ClearFilters"
                                   Size="Size.Small" />
                </MudTooltip>
            </MudTh>

            <MudTh Style="background-color:lightgray; width:180px">
                <MudTableSortLabel SortBy="@((DataOpsPipes x) => x.Name)"
                                   InitialDirection="SortDirection.Ascending">Pipe Name</MudTableSortLabel>
                <MudTextField @bind-Value="filterName" Margin="Margin.Dense" Variant="Variant.Outlined" />
            </MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd Style="white-space:nowrap">
                <MudTooltip Text="Edit">
                    <MudFab StartIcon="@Icons.Material.Filled.Edit"
                            Color="Color.Secondary"
                            Size="Size.Small"
                            IconSize="Size.Small"
                            Class="me-1"
                            Href="@($"/dataops/edit/{context.Name}")" />
                </MudTooltip>
                <MudTooltip Text="Delete">
                    <MudFab StartIcon="@Icons.Material.Filled.Delete"
                            Color="Color.Primary"
                            Size="Size.Small"
                            IconSize="Size.Small"
                            Class="me-1"
                            @onclick="@(() => DeletePipeline(context.Name))" />
                </MudTooltip>
                <MudTooltip Text="Execute">
                    <MudFab StartIcon="@Icons.Material.Filled.PlayArrow"
                            Color="Color.Success"
                            Size="Size.Small"
                            IconSize="Size.Small"
                            Disabled="@(_cts != null)"
                            @onclick="@(() => ExecutePipeline(context.Name))" />
                </MudTooltip>
            </MudTd>

            <MudTd DataLabel="Pipe Name">@context.Name</MudTd>
        </RowTemplate>

        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
}

<div class="mt-4">
    <MudText>DataOps status: @statusMessage</MudText>
    @if (_cts != null)
    {
        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Stop"
                   Class="mt-2"
                   OnClick="CancelPipeline">
            Cancel
        </MudButton>
    }
</div>

@code {
    private string pipelineName = string.Empty;
    private string filterName = string.Empty;
    private string statusMessage = "None running";
    private List<DataOpsPipes>? pipeList;
    private List<PipeLine> pipelines;
    private ResponseDto response;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await RefreshPipes();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dataops: Errors getting pipelines {ex}");
            pipeList ??= new List<DataOpsPipes>();
            await displayMessage.DisplayErrorMessage("Problems getting pipelines");
        }
    }

    private async Task RefreshPipes()
    {
        response = await dataOps.GetPipelines<DatabaseManager.ServerLessClient.Models.ResponseDto>();
        if (response.IsSuccess)
        {
            pipeList = JsonConvert.DeserializeObject<List<DataOpsPipes>>(Convert.ToString(response.Result))
                       ?? new List<DataOpsPipes>();
        }
        else
        {
            string error = string.Join(";", response.ErrorMessages);
            Console.WriteLine($"Dataops: error getting pipelines; {error}");
            pipeList ??= new List<DataOpsPipes>();
        }
    }

    private bool FilterPipes(DataOpsPipes pipe)
    {
        return string.IsNullOrWhiteSpace(filterName)
            || pipe.Name?.Contains(filterName, StringComparison.OrdinalIgnoreCase) == true;
    }

    private void ClearFilters()
    {
        filterName = string.Empty;
    }

    private async Task AddPipeline()
    {
        try
        {
            if (string.IsNullOrEmpty(pipelineName))
            {
                await displayMessage.DisplayErrorMessage("Please enter a new pipeline name");
                return;
            }
            response = await dataOps.CreatePipeline<DatabaseManager.ServerLessClient.Models.ResponseDto>(pipelineName);
            if (!response.IsSuccess)
            {
                string error = string.Join(";", response.ErrorMessages);
                Console.WriteLine($"Dataops: error creating pipeline; {error}");
                await displayMessage.DisplayErrorMessage($"Failed to add pipeline: {error}");
                return;
            }
            await RefreshPipes();
            pipelineName = string.Empty;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errors: {ex}");
            await displayMessage.DisplayErrorMessage("Failed to add pipeline");
        }
    }

    private async Task DeletePipeline(string name)
    {
        try
        {
            response = await dataOps.DeletePipeline<DatabaseManager.ServerLessClient.Models.ResponseDto>(name);
            if (!response.IsSuccess)
            {
                string error = string.Join(";", response.ErrorMessages);
                Console.WriteLine($"Dataops: error deleting pipeline; {error}");
                await displayMessage.DisplayErrorMessage($"Failed to delete pipeline: {error}");
                return;
            }
            await RefreshPipes();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errors: {ex}");
            await displayMessage.DisplayErrorMessage("Failed to delete pipeline");
        }
    }

    private async Task ExecutePipeline(string name)
    {
        const int maxPollAttempts = 200;
        const int pollIntervalMs = 1000;

        _cts = new CancellationTokenSource();
        StateHasChanged();
        Console.WriteLine($"excute pipeline {name}");

        try
        {
            response = await dataOps.GetPipeline<DatabaseManager.ServerLessClient.Models.ResponseDto>(name);
            pipelines = JsonConvert.DeserializeObject<List<PipeLine>>(Convert.ToString(response.Result));
            Console.WriteLine($"Number of pipes are {pipelines.Count}");

            List<DataOpParameters> parms = new List<DataOpParameters>();
            foreach (var pipe in pipelines)
            {
                parms.Add(new DataOpParameters()
                {
                    Id = pipe.Id,
                    Name = pipe.ArtifactType,
                    StorageAccount = settings.AzureStorage,
                    JsonParameters = pipe.Parameters.ToString()
                });
            }

            var request = new DataOpsRequest
            {
                DatabaseProvider = SD.Sqlite ? DatabaseProvider.Sqlite : DatabaseProvider.SqlServer,
                Pipelines = parms
            };

            string parmString = JsonConvert.SerializeObject(request);
            Console.WriteLine($"Pipeline parameters are {parmString}");
            statusMessage = "Starting";
            StateHasChanged();
            var result = await dataOps.ProcessPipeline(request);
            Console.WriteLine(result.statusQueryGetUri);
            for (int i = 0; i < maxPollAttempts; i++)
            {
                _cts.Token.ThrowIfCancellationRequested();
                DataOpsStatus status = await dataOps.GetStatus(result.statusQueryGetUri);
                Console.WriteLine($"Runtime status: {status.runtimeStatus}");
                statusMessage = status.runtimeStatus + ": " + status.customStatus;
                StateHasChanged();
                if (status.runtimeStatus == "Completed")
                {
                    statusMessage = status.runtimeStatus;
                    StateHasChanged();
                    break;
                }
                if (status.runtimeStatus == "Failed")
                {
                    Console.WriteLine("Pipeline failed.");
                    statusMessage = $"Failed: {status.customStatus}";
                    StateHasChanged();
                    break;
                }
                await Task.Delay(pollIntervalMs, _cts.Token);
            }

            if (statusMessage.StartsWith("Starting") ||
                (!statusMessage.StartsWith("Completed") && !statusMessage.StartsWith("Failed")))
            {
                statusMessage = "Timed out waiting for pipeline to complete.";
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            statusMessage = "Cancelled";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errors: {ex}");
        }
        finally
        {
            _cts?.Dispose();
            _cts = null;
            StateHasChanged();
        }
    }

    private void CancelPipeline()
    {
        _cts?.Cancel();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}